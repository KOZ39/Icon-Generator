  "tooltips": {
    "PreviewResolution": "Adjust preview sharpness.\nDoes not affect the saved icon resolution.",
    "PreviewAtIconResolution": "Render at the saved resolution with one image pixel per screen pixel.",
    "ResetCamera": "Reset position, rotation and zoom for the camera being edited.",
    "PreviewSourceRoot": "Click the name to show the combined preview.\nCtrl/Shift + Click: select multiple items\nSpace: toggle checkboxes\nRight-click: item menu",
    "PreviewSource": "Click the name to preview this item, even when unchecked or inactive.\nCtrl/Shift + Click: select multiple items\nSpace: toggle checkboxes\nRight-click: item menu",
    "NoIndividualPreview": "No mesh is available for an individual capture.\nView MA component changes in the combined preview.",
    "CaptureMeshPart": "This item captures regions marked as Delete by MA Shape Changer in {0}.\nApplies to individual captures and combined captures with Selected Items.", // {0}: renderer names, comma-separated
    "CaptureMaterialChange": "This item captures {0} with its MA Material Setter/Swap changes applied, as if its menu were on.\nApplies to individual captures and combined captures with Selected Items.", // {0}: renderer names, comma-separated
    "AddSource": "Add scene objects or prefabs. You can drag in multiple objects.\nAdded sources start checked, even when inactive in the scene.",
    "SearchSources": "Search source and child names.\nWith Selected Items, only selected items visible in the results are captured.",
    "SourceFilter": "Mesh: items with a mesh\nMA Components: MA controls without meshes in their hierarchy\nUnchecked: items unchecked directly or by a parent\nPer-Item Camera: items with per-item camera settings enabled\n\nWith Selected Items, items excluded by search or filters are not captured.",
    "IncludeSource": "Checked by default, regardless of scene activity.\nUnchecking preserves child checkbox states.\nSave Scope determines whether the source is captured.",
    "IncludeSourceItem": "The initial checkbox state matches the object's active state in the scene.\nUnchecking also applies to children and the item's MA components.\nSave Scope determines whether the item is captured.",
    "InheritedExclusion": "Check the parent first to change this checkbox.",
    "RemoveSource": "Remove this source and clear its checkbox states, BlendShape ignore settings and per-item camera settings.",
    "BlendShapeWeightMode": "Single Mesh: apply when capturing one mesh\nMarked Meshes: apply to meshes checked in the right-hand column of Sources, including combined captures\nAll Meshes: apply to every captured mesh\nDisabled: retain existing weights\n\nAffected meshes use zero weights and ignore mesh deletion by MA Shape Changer.",
    "IgnoreMeshBlendShapeWeights": "Set this mesh's weights to zero in Marked Meshes mode.\nAlso ignore mesh deletion by MA Shape Changer.",
    "UseItemCamera": "Use separate camera settings for the selected item.\nThe first activation copies the shared settings.\nDisabling switches back to the shared settings.\nRe-enabling uses the item's previously saved settings.",
    "ItemCameraIndicator": "Using per-item camera settings.",
    "HorizontalPosition": "Offset as a percentage of the icon width.\n0: center\n+: right\n−: left",
    "VerticalPosition": "Offset as a percentage of the icon height.\n0: center\n+: up\n−: down",
    "ResetPosition": "Reset horizontal and vertical position to 0.",
    "ResetPitch": "Reset pitch to 0.",
    "ResetYaw": "Reset yaw to 180.",
    "ResetRoll": "Reset roll to 0.",
    "Zoom": "Keep in Frame may further limit zoom.\nDefault: 1\nSlider and scroll wheel: 0.5–5\nDirect input: 0.01 or greater",
    "ResetZoom": "Reset zoom to 1 for the camera being edited.",
    "Padding": "Higher values leave more space around the object.",
    "ResetPadding": "Reset padding to 0.1.",
    "KeepWholeObject": "Limit zoom and movement to keep the whole object inside the image.",
    "UseVisibleArea": "Framing, padding and Keep in Frame use this area.\nEnabled: visible part of the object\nDisabled: full mesh bounds",
    "IconResolution": "Width and height of the saved icon.",
    "GenerationMode": "Both: save combined and individual icons\nCombined: save items in Save Scope together in one image\nIndividual: save groups, meshes and extracted regions separately\n\nIdentical capture regions with the same camera and MA component state are saved once.",
    "SaveScope": "All Items: include unchecked and inactive items in individual captures; combined captures follow checkboxes\nChecked Items: capture according to checkboxes\nSelected Items: capture items selected in the list and their children, regardless of checkbox or active state\n\nAlso applies to combined previews.\nEditorOnly items and their children are excluded.",
    "UnknownFileNameToken": "Unknown placeholder: {0}", // {0}: token as typed, e.g. {nmae}
    "FileNameTokenSuggestion": "Suggested placeholder: {0}", // {0}: closest valid token, e.g. {name}
    "FileNameExample": "File name preview: {0}\nA number may be appended if the file name already exists.", // {0}: file name with extension, e.g. Eku_front.png
    "BackgroundColor": "Fill the background with this color when Transparent is disabled.",
    "TransparentBackground": "Use a transparent background instead of Background Color.",
    "OutlineColor": "Color of the outline added around objects.",
    "Outline": "Add an outline around objects.",
    "FileName": "Leave blank to use {name}.\n\n{name}: target name (Combined for multiple combined targets)\n{resolution}: icon resolution\n{direction}: camera preset name in lowercase English, or custom\n{date}: date yyyyMMdd\n{time}: time HHmmss\n\nExample: {name}_{direction}\nDate and time use the start of generation.",
    "SaveFolder": "Enter an Assets/... path or an absolute folder path.",
    "ShowSaveFolderInProject": "Show the save folder's contents in Unity's Project window.",
    "SaveFolderNotInProject": "This folder is not available in the Project window.",
    "SaveFolderMissing": "Missing folders are created when saving an icon.",
    "MenuIconLink": "After saving, find MA Menu Items (Toggle/Button) that control the saved items and link their icons.\nDon't Link: do nothing\nConfirm Before Linking: choose menus in a dialog\nAuto-Link Menus Without Icons: link only menus without an icon\n\nIcons saved outside the Assets folder cannot be linked. A single undo reverts all links."
  },
