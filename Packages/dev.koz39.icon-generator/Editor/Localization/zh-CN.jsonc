  "tooltips": {
    "PreviewResolution": "调整预览的清晰度。\n不影响保存图标的分辨率。",
    "PreviewAtIconResolution": "按保存分辨率渲染，图像的 1 个像素对应屏幕的 1 个像素。",
    "ResetCamera": "将当前编辑的相机位置、旋转和缩放恢复为默认值。",
    "PreviewSourceRoot": "点击名称可查看合成预览。\nCtrl/Shift + 点击：多选\nSpace：切换勾选状态\n右键：操作菜单",
    "PreviewSource": "点击名称即可预览，即使该项未勾选或未激活。\nCtrl/Shift + 点击：多选\nSpace：切换勾选状态\n右键：操作菜单",
    "NoIndividualPreview": "没有可单独拍摄的网格。\n请在合成预览中查看 MA 组件的应用结果。",
    "CaptureMeshPart": "此项会拍摄从 {0} 中提取的、由 MA Shape Changer 设为 Delete 的区域。\n适用于单独拍摄，以及保存范围为“选中项”时的合成拍摄。", // {0}: renderer names, comma-separated
    "CaptureMaterialChange": "此项会在菜单开启的状态下拍摄应用了 MA Material Setter/Swap 的 {0}。\n适用于单独拍摄，以及保存范围为“选中项”时的合成拍摄。", // {0}: renderer names, comma-separated
    "AddSource": "添加场景对象或预制体，也可以一次拖入多个对象。\n添加的源对象默认勾选，即使它在场景中未激活。",
    "SearchSources": "按名称搜索源对象及其子项。\n保存范围为“选中项”时，只拍摄搜索结果中可见的选中项。",
    "SourceFilter": "网格：包含网格的项\nMA 组件：自身及子对象均不含网格的 MA 控制项\n未勾选：自身或父项未勾选的项\n独立相机：已启用独立相机的项\n\n保存范围为“选中项”时，被搜索或筛选排除的项不参与拍摄。",
    "IncludeSource": "默认勾选，不受场景中激活状态的影响。\n取消勾选后，子项的勾选状态仍会保留。\n是否参与拍摄由“保存范围”决定。",
    "IncludeSourceItem": "初始勾选状态与场景中的激活状态一致。\n取消勾选也会作用于子项及该项的 MA 组件。\n是否参与拍摄由“保存范围”决定。",
    "InheritedExclusion": "请先勾选父项，再更改此复选框。",
    "RemoveSource": "从列表中移除此源对象，并清除它的勾选状态、忽略权重设置和独立相机设置。",
    "BlendShapeWeightMode": "单个网格：拍摄一个网格时应用\n指定网格：应用于源对象列表右侧勾选的网格，包括合成拍摄\n所有网格：应用于所有参与拍摄的网格\n禁用：保留原有权重\n\n将目标网格的权重归零，并忽略 MA Shape Changer 的网格删除操作。",
    "IgnoreMeshBlendShapeWeights": "在“指定网格”模式下，将此网格的权重归零。\n同时忽略 MA Shape Changer 的网格删除操作。",
    "UseItemCamera": "为选中的项使用独立相机设置。\n首次启用时复制共用设置。\n禁用时使用共用设置。\n重新启用时使用之前保存的独立设置。",
    "ItemCameraIndicator": "正在使用独立相机设置。",
    "HorizontalPosition": "相对于图标宽度的移动比例。\n0：居中\n+：向右\n−：向左",
    "VerticalPosition": "相对于图标高度的移动比例。\n0：居中\n+：向上\n−：向下",
    "ResetPosition": "将水平和垂直位置重置为 0。",
    "ResetPitch": "将上下旋转重置为 0。",
    "ResetYaw": "将左右旋转重置为 180。",
    "ResetRoll": "将倾斜重置为 0。",
    "Zoom": "启用“防止裁切”时，缩放范围可能会进一步受限。\n默认值：1\n滑块和滚轮：0.5～5\n直接输入：0.01 及以上",
    "ResetZoom": "将当前编辑的相机缩放重置为 1。",
    "Padding": "数值越大，对象周围的留白越宽。",
    "ResetPadding": "将留白比例重置为 0.1。",
    "KeepWholeObject": "限制缩放和平移范围，防止对象超出图像边缘。",
    "UseVisibleArea": "构图、留白和防止裁切均以此范围为准。\n启用：实际可见部分\n禁用：整个网格的包围盒",
    "IconResolution": "保存图标的宽度和高度。",
    "GenerationMode": "合成与单独：同时保存合成图标和单独图标\n合成：将保存范围内的内容合成一张图标\n单独：按分组、网格和提取区域分别保存\n\n拍摄区域、构图和 MA 组件应用状态相同时，只保存一次。",
    "SaveScope": "所有项：单独拍摄包含未勾选、未激活的项；合成拍摄遵循勾选状态\n已勾选项：按勾选状态拍摄\n选中项：拍摄列表中选中的项及其子项，不受勾选或激活状态影响\n\n同样适用于合成预览。\n排除 EditorOnly 项及其子项。",
    "UnknownFileNameToken": "未知占位符：{0}", // {0}: token as typed, e.g. {nmae}
    "FileNameTokenSuggestion": "建议占位符：{0}", // {0}: closest valid token, e.g. {name}
    "FileNameExample": "文件名预览：{0}\n保存同名文件时，可能会添加编号。", // {0}: file name with extension, e.g. Eku_front.png
    "BackgroundColor": "禁用“透明”时，使用此颜色填充背景。",
    "TransparentBackground": "使用透明背景代替背景色。",
    "OutlineColor": "对象外轮廓的描边颜色。",
    "Outline": "为对象外轮廓添加描边。",
    "FileName": "留空时使用 {name}。\n\n{name}：目标名称（合成多个目标时为 Combined）\n{resolution}：图标分辨率\n{direction}：相机预设的英文小写名称，其他角度为 custom\n{date}：日期 yyyyMMdd\n{time}：时间 HHmmss\n\n示例：{name}_{direction}\n日期和时间以生成开始时为准。",
    "SaveFolder": "输入 Assets/... 形式的路径，或文件夹的绝对路径。",
    "ShowSaveFolderInProject": "在 Unity 的项目窗口中显示保存文件夹的内容。",
    "SaveFolderNotInProject": "此文件夹无法在项目窗口中显示。",
    "SaveFolderMissing": "不存在的文件夹会在保存图标时创建。",
    "MenuIconLink": "保存图标后，查找控制已保存项的 MA Menu Item（开关/按钮）并关联图标。\n不关联：不执行任何操作\n确认后关联：在对话框中选择要关联的菜单\n仅自动关联空图标：只为没有图标的菜单自动关联\n\n保存在 Assets 文件夹之外的图标无法关联。撤销一次即可取消全部关联。"
  },
